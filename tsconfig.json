{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist/",
    "noImplicitAny": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "target": "ES2022",
    "jsx": "react",
    "allowJs": true,
    "sourceMap": true
  },
    "include": [
      "src/**/*",
      "declarations.d.ts"
    ]
}